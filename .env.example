# Quantum News Explorer — Environment Variables
# Copy this file to .env and fill in values.

# GNews API key (optional — falls back to RSS or mock without it)
# Get one at https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# Force mock data (true | false). Defaults to false.
USE_MOCK=false

# Preferred provider: "gnews" | "rss" | "mock" (optional, auto-detected)
PROVIDER=

# Cache lifetime in minutes (default 30)
CACHE_MINUTES=30

# Maximum article age in days (default 30)
MAX_AGE_DAYS=30

# Server port (default 3000)
PORT=3000
